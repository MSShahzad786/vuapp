rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users can read and write their own user documents
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Users can read and write their own userTests subcollection
    match /users/{userId}/userTests/{testId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Users can read and write their own selectedSubjects subcollection
    match /users/{userId}/selectedSubjects/{docId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Users can read and write their own tests
    match /tests/{testId} {
      allow read, write: if request.auth != null && request.auth.uid == resource.data.userId;
    }

    // Allow reading subjects metadata for authenticated users
    match /subjectsMetaData/{docId} {
      allow read: if request.auth != null;
    }

    // Allow reading subjects, chapters, MCQs, and short questions (public data)
    match /subjects/{subjectId} {
      allow read: if request.auth != null;
    }

    match /chapters/{chapterId} {
      allow read: if request.auth != null;
    }

    match /mcqs/{mcqId} {
      allow read: if request.auth != null;
    }

    match /shortQuestions/{questionId} {
      allow read: if request.auth != null;
    }

    // Allow reading userSubjects for the authenticated user
    match /userSubjects/{userSubjectId} {
      allow read, write: if request.auth != null && request.auth.uid == resource.data.userId;
    }

    // Allow reading mySubjects and its subcollections for authenticated users
    match /mySubjects/{subjectId} {
      allow read: if request.auth != null;
    }

    match /mySubjects/{subjectId}/chapters/{chapterId} {
      allow read: if request.auth != null;
    }

    // Alternative wildcard rule for mySubjects (covers all subpaths)
    match /mySubjects/{path=**} {
      allow read, write: if request.auth != null;
    }
  }
}